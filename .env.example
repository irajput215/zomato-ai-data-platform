# =============================================================================
# Zomato AI Data Engineering — environment template
# =============================================================================
# Copy to `.env` and fill in.  NEVER commit the filled-in `.env`.
#   cp .env.example .env
#
# Every component reads the same variable names, so one file configures
# Snowflake (dbt + Airflow), AWS (S3 upload), and OpenAI (the AI layer).
# =============================================================================

# --- Snowflake ---------------------------------------------------------------
# account is the *account identifier*, e.g. abcd1234.eu-west-1  or  abcd1234-xy12345
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Password auth: set SNOWFLAKE_PASSWORD and leave the key-pair vars empty.
SNOWFLAKE_PASSWORD=
# Key-pair auth (optional, more secure): set the path to your unencrypted PKCS#8
# private key and leave SNOWFLAKE_PASSWORD empty.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=ZOMATO_WH
SNOWFLAKE_DATABASE=ZOMATO
# Base schema. dbt overrides this per layer (STAGING / MARTS / SNAPSHOTS).
SNOWFLAKE_SCHEMA=STAGING

# The read-only role the text-to-SQL app uses. It can only SELECT.
SNOWFLAKE_AI_ROLE=ZOMATO_AI_RO

# --- AWS / S3 ----------------------------------------------------------------
# Leave AWS_PROFILE empty to use the default credential chain
# (~/.aws/credentials, SSO, or an instance role).
AWS_PROFILE=
AWS_REGION=us-east-1
S3_BUCKET=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pipeline knobs ----------------------------------------------------------
# How many reviews the LLM enrichment job processes per run (cost guard).
SAMPLE_N=5
# How many reviews the RAG app loads and embeds.
RAG_SAMPLE_N=500

# --- dbt ---------------------------------------------------------------------
# Selects the output in zomato/profiles.yml:
#   dev           password auth (default)
#   prod          password auth, production query tag
#   dev_keypair   key-pair auth (JWT) — also set SNOWFLAKE_PRIVATE_KEY_PATH
#
#   DBT_TARGET=dev_keypair dbt build --profiles-dir zomato
DBT_TARGET=dev
DBT_THREADS=8

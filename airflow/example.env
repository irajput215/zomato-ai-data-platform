# =============================================================================
# Airflow — environment template
# =============================================================================
#   cp example.env .env
#   docker compose build && docker compose up -d
#
# docker-compose.yaml passes every value below into the Airflow containers.
# The same variables configure dbt (through profiles.yml) and the AI enrichment
# task, so this one file is the only place credentials live.
#
# NEVER commit the filled-in .env — it is already in .gitignore.
# =============================================================================

# --- Snowflake ---------------------------------------------------------------
# The account identifier, e.g. abcd1234.eu-west-1 or abcd1234-xy12345
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=ZOMATO_WH
SNOWFLAKE_DATABASE=ZOMATO
SNOWFLAKE_SCHEMA=STAGING

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Reviews the enrichment task processes per run. Keep it small while you are
# learning; raise it once you are happy with the cost and the label quality.
SAMPLE_N=5

# --- dbt ---------------------------------------------------------------------
# Selects the output in zomato/profiles.yml:
#   dev           password auth (default)
#   prod          password auth, production query tag
#   dev_keypair   key-pair auth (JWT) — see the key-pair section at the bottom;
#                 the private key must be mounted into the containers AND
#                 AIRFLOW_CONN_SNOWFLAKE_DEFAULT must be switched to JWT too,
#                 otherwise the COPY task and dbt would authenticate differently.
DBT_TARGET=dev
DBT_THREADS=8

# --- Docker / Airflow --------------------------------------------------------
# On Linux, set this to your own uid so files written into ./logs and
# ../zomato/target are owned by you rather than root:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# =============================================================================
# OPTIONAL — key-pair auth instead of a password (recommended for anything real)
# =============================================================================
# 1. Generate a key pair and register the public half on the Snowflake user:
#      openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out rsa_key.p8
#      openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
#      ALTER USER <you> SET RSA_PUBLIC_KEY='<contents of rsa_key.pub without headers>';
#
# 2. Mount the private key into the container and point Snowflake at it. Add to
#    the x-airflow-common volumes and environment blocks in docker-compose.yaml:
#      - ../rsa_key.p8:/opt/airflow/keys/rsa_key.p8:ro
#      SNOWFLAKE_PRIVATE_KEY_PATH: /opt/airflow/keys/rsa_key.p8
#    and switch AIRFLOW_CONN_SNOWFLAKE_DEFAULT's "extra" to include
#      "private_key_file":"/opt/airflow/keys/rsa_key.p8","authenticator":"snowflake_jwt"
#
# Key-pair auth means no password is ever stored in the Airflow metadata database,
# which is the main reason to prefer it over SNOWFLAKE_PASSWORD.

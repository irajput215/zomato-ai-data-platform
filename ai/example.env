# =============================================================================
# AI layer — environment template
# =============================================================================
# The AI scripts read the SAME variables as the rest of the project, so the
# project-root `.env` is usually all you need:
#
#     cp ../.env.example ../.env     # from inside ai/
#
# This file documents only what the AI layer cares about. If you prefer to keep
# a separate file, copy this one to `ai/.env` — common.py loads the project-root
# `.env` first, and anything already exported in your shell wins.
# =============================================================================

# --- Snowflake (required by all three apps) ----------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Optional: key-pair auth. When set, SNOWFLAKE_PASSWORD is ignored.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=ZOMATO_WH
SNOWFLAKE_DATABASE=ZOMATO
SNOWFLAKE_SCHEMA=STAGING

# The SELECT-only role the text-to-SQL app and the dashboard connect as.
# Created in snowflake/01_setup.sql. Never point this at DBT_ROLE.
SNOWFLAKE_AI_ROLE=ZOMATO_AI_RO

# --- OpenAI (required) -------------------------------------------------------
OPENAI_API_KEY=

# Swappable so you can trade cost against quality without editing code.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Cost guards -------------------------------------------------------------
# Max reviews enrich_reviews.py processes per run.
SAMPLE_N=5
# Default number of reviews rag_chat.py loads and embeds.
RAG_SAMPLE_N=500
